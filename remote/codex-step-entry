#!/usr/bin/env bash
# Normal srun payload. This is not a diagnostic or an allocation launcher.
set -euo pipefail
die() { printf '%s\n' "$*" >&2; exit 64; }
[[ $# -ge 3 ]] || die 'Missing Codex step arguments.'
expected_job=$1; state_root=$2; shift 2
[[ "$expected_job" =~ ^[0-9]+$ && "${SLURM_JOB_ID:-}" == "$expected_job" &&
   "${SLURM_STEP_ID:-}" =~ ^[0-9]+$ ]] || die 'Expected the recorded Slurm job step.'
upstream="$HOME/.local/bin/codex-direct"
[[ -x "$upstream" ]] || die 'Codex upstream executable is missing.'

# Unknown proxy forms must not silently initialize the listener's shared home.
# Listener and other app-server invocations keep their original environment.
proxy=false
for arg in "$@"; do [[ "$arg" != proxy ]] || proxy=true; done
if "$proxy"; then
  [[ $# == 2 && "$1" == app-server && "$2" == proxy ]] || die 'Only the default app-server proxy form is supported.'
  listener_home="${CODEX_HOME:-$HOME/.codex}"
  [[ "$listener_home" == /* && "$listener_home" != *$'\n'* && "$listener_home" != *$'\r'* &&
     -d "$listener_home" && ! -L "$listener_home" && -O "$listener_home" ]] || die 'Listener home must be an owned absolute directory.'
  control_dir="$listener_home/app-server-control"
  socket_path="$control_dir/app-server-control.sock"
  [[ -d "$control_dir" && ! -L "$control_dir" && -O "$control_dir" &&
     -S "$socket_path" && ! -L "$socket_path" && -O "$socket_path" ]] || die 'Owned listener control socket is unavailable.'
  [[ "$state_root" == /* && "$state_root" != *$'\n'* && "$state_root" != *$'\r'* ]] || die 'Proxy state directory must be an absolute path.'
  proxy_root="$state_root/proxy-homes/job-$expected_job"
  canonical_root=$(readlink -m -- "$proxy_root")
  canonical_tmp=$(readlink -m -- "${TMPDIR:-/tmp}")
  # Codex helper initialization itself rejects homes beneath the system temp
  # directory. Use shared state beside the allocation TMPDIR, not within it.
  [[ "$canonical_root" != "$canonical_tmp" && "$canonical_root" != "${canonical_tmp%/}/"* ]] || die 'Proxy home must be outside the system temporary directory.'
  umask 077
  for directory in "$state_root" "$state_root/proxy-homes" "$proxy_root"; do
    [[ ! -L "$directory" ]] || die 'Proxy state directory must not be a symlink.'
    if [[ ! -e "$directory" ]]; then mkdir -p -- "$directory"; fi
    [[ -d "$directory" && -O "$directory" ]] || die 'Proxy state directory must be user-owned.'
  done
  # All operands are checked absolute paths; keep the portable mode/file syntax.
  chmod 700 "$state_root/proxy-homes" "$proxy_root"
  proxy_home=$(mktemp -d "$proxy_root/request.XXXXXXXXXXXX")
  [[ -d "$proxy_home" && ! -L "$proxy_home" && -O "$proxy_home" ]] || die 'Could not create a private proxy home.'
  chmod 700 "$proxy_home"
  export CODEX_HOME="$proxy_home"
  # Resolve the real listener socket before changing the client-only home.
  # The listener retains all configuration, credentials, sessions and Goals.
  set -- app-server proxy --sock "$socket_path"
fi

# Preserve streams, signals, exit status and process identity; no cleanup trap
# may remove a directory while Codex still holds a helper guard in it.
exec "$upstream" "$@"
