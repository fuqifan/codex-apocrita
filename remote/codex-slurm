#!/usr/bin/env bash
set -euo pipefail

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/codex-apocrita"
job_file="$state_root/job-id"
upstream="$HOME/.local/bin/codex-direct"
[[ -x "$upstream" ]] || { echo "Codex is not installed: $upstream" >&2; exit 1; }
[[ -r "$job_file" ]] || { echo 'No Codex Slurm allocation. Run apo first.' >&2; exit 1; }
read -r job_id < "$job_file"
[[ "$job_id" =~ ^[0-9]+$ ]] || { echo 'Invalid recorded Slurm job ID.' >&2; exit 1; }
state=$(squeue --jobs="$job_id" --noheader --format='%T' 2>/dev/null | head -n 1)
[[ "$state" == RUNNING ]] || { echo "Slurm allocation $job_id is not running (${state:-missing})." >&2; exit 1; }
owner=$(squeue --jobs="$job_id" --noheader --format='%u' 2>/dev/null | head -n 1)
[[ "$owner" == "$(id -un)" ]] || { echo "Slurm allocation $job_id is not owned by this user." >&2; exit 1; }
shared_tmp="$state_root/tmp/job-$job_id"
mkdir -p "$shared_tmp"; chmod 700 "$shared_tmp"
exec srun --jobid="$job_id" --overlap --unbuffered --ntasks=1 \
  env TMPDIR="$shared_tmp" TMP="$shared_tmp" TEMP="$shared_tmp" \
  "$upstream" "$@"
